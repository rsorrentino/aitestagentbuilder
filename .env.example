# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/aitestagentbuilder
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aitestagentbuilder
DB_USER=user
DB_PASSWORD=password

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Alternatively, point to a local/alternative endpoint:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Redis (optional — used for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Executor (Python service)
EXECUTOR_URL=http://localhost:8001

# Integrations (optional)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

TESTRAIL_BASE_URL=https://your-org.testrail.io
TESTRAIL_USER=you@example.com
TESTRAIL_API_KEY=

# Observability (optional)
LOG_LEVEL=info
METRICS_ENABLED=true
