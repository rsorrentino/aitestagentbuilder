# AI Test Agent Builder — Environment Configuration
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------------
# Server
# -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------
DB_URL=postgresql://postgres:password@localhost:5432/aitestagentbuilder
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aitestagentbuilder
DB_USER=postgres
DB_PASSWORD=password

# -----------------------------------------------------------------
# AI / LLM Providers
# -----------------------------------------------------------------
# Primary provider: openai | azure | anthropic | copilot
LLM_PROVIDER=anthropic

# Anthropic Claude (recommended for extraction, chat, self-healing)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (required for embeddings; also usable as chat provider)
OPENAI_API_KEY=sk-...

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# GitHub Copilot (optional — uses GITHUB_TOKEN)
GITHUB_TOKEN=ghp_...

# -----------------------------------------------------------------
# Salesforce CRM
# -----------------------------------------------------------------
SF_USERNAME=user@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token

# -----------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
API_KEY_SALT=change-me-in-production

# -----------------------------------------------------------------
# Redis (optional — for rate limiting and caching)
# -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# Executor (Python service)
# -----------------------------------------------------------------
EXECUTOR_URL=http://localhost:8001
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# -----------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000

# -----------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
