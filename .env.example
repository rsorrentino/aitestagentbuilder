# ─────────────────────────────────────────────────────────────────────────────
# AI Test Agent Builder — configuration
# Copy to .env (repo root or backend/) and adjust. Only DATABASE_URL is required.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins (default: any)
# CORS_ORIGIN=http://localhost:4000

# Database (PostgreSQL 14+). `docker compose up -d postgres` matches this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aitestagentbuilder

# ── Authentication ───────────────────────────────────────────────────────────
# Off by default (single-user local mode). When true, the UI shows a login page
# and the API needs a JWT (POST /api/v1/auth/login) or an API key.
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
# Bootstrap admin user, created on start if it does not exist
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# ── AI providers (configure at least one for extraction/generation/chat) ─────
# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (or any OpenAI-compatible endpoint, e.g. Ollama)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://localhost:11434/v1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# GitHub Copilot — choose a transport:
#   api : Copilot chat API with a GitHub token (e.g. `gh auth token`)
#   sdk : official @github/copilot-sdk (installed with the backend)
#   cli : GitHub Copilot CLI (`npm install -g @github/copilot`)
COPILOT_MODE=api
# Token (checked in this order): COPILOT_GITHUB_TOKEN, GH_TOKEN, GITHUB_TOKEN.
# sdk/cli modes can also use an existing `copilot` /login or `gh auth login`.
# COPILOT_GITHUB_TOKEN=
# COPILOT_MODEL=gpt-4o
# Use GitHub Models instead of the Copilot API (api mode):
# COPILOT_BASE_URL=https://models.github.ai/inference
# Path to the Copilot CLI binary (cli mode)
# COPILOT_CLI_PATH=copilot

# Force one provider first for every task: anthropic | openai | copilot | azure
# LLM_PROVIDER=

# ── Test execution ───────────────────────────────────────────────────────────
# node   = built-in Playwright executor (default, recommended)
# python = legacy executor in /executor (pip install -r executor/requirements.txt)
EXECUTOR=node
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome
# Per-step timeout in ms
STEP_TIMEOUT_MS=10000
MAX_CONCURRENT_RUNS=2
# Recorder: browsers open at once for recording tests (each closes after 10 idle minutes)
# RECORDER_MAX_SESSIONS=4
# Sign in once (MFA by a person): browsers open at once
# SIGNIN_MAX_SESSIONS=4
# Where screenshots are stored (served at /artifacts)
# ARTIFACTS_PATH=./artifacts
# REPORT_STORAGE_PATH=./reports

# Built-in demo app at /demo (used by "Try the demo")
DEMO_ENABLED=true

# ── Optional ─────────────────────────────────────────────────────────────────
# Redis for distributed rate limiting (falls back to memory if unreachable)
# REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Frontend (frontend/.env.local): NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
