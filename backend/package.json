{
  "name": "ai-test-agent-builder-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Test Agent Builder",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 src/tests/*.test.ts",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=1 src/tests/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:migrate:prod": "node dist/infra/db/migrate.js",
    "playwright:install": "playwright install chromium",
    "cli": "tsx src/cli/index.ts",
    "seed:demo": "tsx src/demo/seed-demo.ts"
  },
  "keywords": [
    "ai",
    "testing",
    "automation",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@axe-core/playwright": "^4.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.6.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.13",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^5.0.5",
    "socket.io": "^4.5.4",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "^6.0.5",
    "@types/swagger-ui-express": "^4.1.8",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "^1.0.30"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
